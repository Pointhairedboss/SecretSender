{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secretsender-edge",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "BITBOP_API",
      "service": "bitbop-api"
    }
  ],
  "routes": [
    {
      "pattern": "secrets.bitbop.dev",
      "custom_domain": true
    }
  ]
}
